{
  "name": "@local/dsh-mobile-hide",
  "version": "1.0.0",
  "private": true,
  "description": "Mobile trims for the DSH Web UI: hides the desktop mascot and the meme trigger on narrow touch screens, and keeps the permission/model pickers on one line.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
